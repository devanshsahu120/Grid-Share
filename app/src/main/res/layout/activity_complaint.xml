<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/newbg"
    android:padding="16dp"
    tools:context=".complaint">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:gravity="center_horizontal">

        <!-- Page Title -->
        <TextView
            android:id="@+id/complaint_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Log a Complaint"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#00FFFF"
            android:layout_marginBottom="20dp" />

        <!-- Section: Select Problem Area -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select the areas where issues are found:"
            android:textSize="19sp"
            android:textColor="#FFFEFE"
            android:layout_marginBottom="10dp" />

        <CheckBox
            android:id="@+id/check_production"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Problem in Production"
            android:textColor="#FAFAFA"
            android:buttonTint="#00FFFF" />

        <CheckBox
            android:id="@+id/check_consumption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Problem in Consumption"
            android:textColor="#FDFDFD"
            android:buttonTint="#00FFFF" />

        <CheckBox
            android:id="@+id/check_storage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Problem in Storage"
            android:textColor="#FFFDFD"
            android:buttonTint="#00FFFF" />

        <CheckBox
            android:id="@+id/check_analytics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Proble in Analytics"
            android:textColor="#FDFCFC"
            android:buttonTint="#00FFFF" />

        <CheckBox
            android:id="@+id/check_live_data"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Problem in Live Data"
            android:textColor="#FFFFFF"
            android:buttonTint="#00FFFF" />

        <!-- Section: Describe Problem -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Describe the issue:"
            android:textSize="18sp"
            android:textColor="#FDFDFD"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/edit_description"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:backgroundTint="#00FFFF"
            android:hint="Explain the problem here..."
            android:textColor="#F8F4F4"
            android:textColorHint="#80FFFCFC"
            android:gravity="top|start"
            android:padding="12dp"
            android:inputType="textMultiLine" />

        <!-- Section: Contact Info -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Operator Name:"
            android:textSize="18sp"
            android:textColor="#FBFBFB"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edit_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#00FFFF"
            android:hint="Enter your name"
            android:textColor="#FFFFFF"
            android:textColorHint="#80FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Contact Number:"
            android:textSize="18sp"
            android:textColor="#FFFCFC"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/edit_contact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#00FFFF"
            android:hint="Enter contact number"
            android:inputType="phone"
            android:textColor="#FFFFFF"
            android:textColorHint="#80FFFFFF" />

        <!-- Submit Button -->
        <Button
            android:id="@+id/btn_submit_complaint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Submit Complaint"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:backgroundTint="#00FFFF"
            android:layout_marginTop="25dp"
            android:layout_marginBottom="16dp" />
    </LinearLayout>

</ScrollView>
